    "import os\n",
    "import cv2\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import kagglehub\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# 1. Descargar el dataset automáticamente con kagglehub\n",
    "print(\"--- Descargando/Verificando Dataset ---\")\n",
    "path = kagglehub.dataset_download(\"alessiocorrado99/animals10\")\n",
    "print(f\"Dataset descargado en el caché: {path}\")\n",
    "\n",
    "# 2. Verificar la ruta de las carpetas de clases\n",
    "# (A veces Kaggle descarga una carpeta extra llamada 'raw-img')\n",
    "DATASET_DIR = os.path.join(path, \"raw-img\")\n",
    "if not os.path.exists(DATASET_DIR):\n",
    "    DATASET_DIR = path\n",
    "\n",
    "OUTPUT_DIR = \"./processed_data\"\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "CLASSES = sorted(os.listdir(DATASET_DIR))\n",
    "# Filtrar solo carpetas\n",
    "CLASSES = [c for c in CLASSES if os.path.isdir(os.path.join(DATASET_DIR, c))]\n",
    "class_to_idx = {cls_name: i for i, cls_name in enumerate(CLASSES)}\n",
    "\n",
    "valid_paths = []\n",
    "labels = []\n",
    "corrupted_files = []\n",
    "\n",
    "print(\"\\n--- Paso 1: Limpieza e Inspección (EDA) ---\")\n",
    "for class_name in CLASSES:\n",
    "    class_dir = os.path.join(DATASET_DIR, class_name)\n",
    "    \n",
    "    for fname in os.listdir(class_dir):\n",
    "        fpath = os.path.join(class_dir, fname)\n",
    "        \n",
    "        try:\n",
    "            img = cv2.imread(fpath)\n",
    "            if img is None:\n",
    "                corrupted_files.append(fpath)\n",
    "            else:\n",
    "                valid_paths.append(fpath)\n",
    "                labels.append(class_to_idx[class_name])\n",
    "        except Exception as e:\n",
    "            corrupted_files.append(fpath)\n",
    "\n",
    "print(f\"Imágenes válidas encontradas: {len(valid_paths)}\")\n",
    "print(f\"Archivos dañados o ilegibles omitidos: {len(corrupted_files)}\")\n",
    "\n",
    "# 3. División del Dataset (70% Train, 15% Val, 15% Test)\n",
    "print(\"\\n--- Paso 2: División de Datos (70 / 15 / 15) ---\")\n",
    "X_train_paths, X_temp_paths, y_train, y_temp = train_test_split(\n",
    "    valid_paths, \n",
    "    labels, \n",
    "    test_size=0.30, \n",
    "    random_state=42, \n",
    "    stratify=labels\n",
    ")\n",
    "\n",
    "X_val_paths, X_test_paths, y_val, y_test = train_test_split(\n",
    "    X_temp_paths, \n",
    "    y_temp, \n",
    "    test_size=0.50, \n",
    "    random_state=42, \n",
    "    stratify=y_temp\n",
    ")\n",
    "\n",
    "print(f\"Conjunto de Entrenamiento (Train): {len(X_train_paths)} imágenes\")\n",
    "print(f\"Conjunto de Validación (Val):       {len(X_val_paths)} imágenes\")\n",
    "print(f\"Conjunto de Prueba (Test):          {len(X_test_paths)} imágenes\")\n",
    "\n",
    "# 4. Guardar listas\n",
    "print(\"\\n--- Paso 3: Guardar listas de datos ---\")\n",
    "df_train = pd.DataFrame({'path': X_train_paths, 'label': y_train})\n",
    "df_val   = pd.DataFrame({'path': X_val_paths,   'label': y_val})\n",
    "df_test  = pd.DataFrame({'path': X_test_paths,  'label': y_test})\n",
    "\n",
    "df_train.to_csv(os.path.join(OUTPUT_DIR, \"train_split.csv\"), index=False)\n",
    "df_val.to_csv(os.path.join(OUTPUT_DIR, \"val_split.csv\"), index=False)\n",
    "df_test.to_csv(os.path.join(OUTPUT_DIR, \"test_split.csv\"), index=False)\n",
    "\n",
    "print(\"¡Listo! Los archivos CSV han sido guardados en la carpeta processed_data.\")"
