    "import joblib\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "# 1. Definir los modelos base y sus mallas de hiperparámetros (GridSearch)\n",
    "param_grids = {\n",
    "    'LogisticRegression': {\n",
    "        'model': LogisticRegression(max_iter=1000, random_state=42),\n",
    "        'params': {\n",
    "            'C': [0.1, 1.0, 10.0]\n",
    "        }\n",
    "    },\n",
    "    'RandomForest': {\n",
    "        'model': RandomForestClassifier(random_state=42),\n",
    "        'params': {\n",
    "            'n_estimators': [50, 100],\n",
    "            'max_depth': [10, 20, None]\n",
    "        }\n",
    "    },\n",
    "    'SVM': {\n",
    "        'model': SVC(random_state=42),\n",
    "        'params': {\n",
    "            'C': [0.1, 1.0, 10.0],\n",
    "            'kernel': ['rbf', 'linear']\n",
    "        }\n",
    "    }\n",
    "}\n",
    "\n",
    "best_models = {}\n",
    "\n",
    "print(\"--- Entrenando Modelos Clásicos con GridSearchCV ---\")\n",
    "for model_name, config in param_grids.items():\n",
    "    print(f\"\\nEntrenando {model_name}...\")\n",
    "    grid = GridSearchCV(\n",
    "        estimator=config['model'],\n",
    "        param_grid=config['params'],\n",
    "        cv=3,                 # Validación cruzada de 3 pliegues\n",
    "        scoring='accuracy',\n",
    "        n_jobs=-1,            # Usa todos los núcleos de tu procesador\n",
    "        verbose=1\n",
    "    )\n",
    "    grid.fit(X_train_features, y_train)\n",
    "    \n",
    "    best_models[model_name] = grid.best_estimator_\n",
    "    print(f\"Mejores hiperparámetros para {model_name}: {grid.best_params_}\")\n",
    "    print(f\"Mejor Accuracy en CV: {grid.best_score_:.4f}\")\n",
    "\n",
    "# Guardar los modelos entrenados para que Betzie u otros puedan cargarlos\n",
    "os.makedirs(\"./saved_models\", exist_ok=True)\n",
    "for name, model in best_models.items():\n",
    "    joblib.dump(model, f\"./saved_models/{name}_best.pkl\")\n",
